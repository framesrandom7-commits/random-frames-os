model CustomFieldDefinition {
  id          String   @id @default(cuid())
  entityType  String   // "LEAD", "CLIENT", "PROJECT", "SHOOT"
  name        String   // Internal key, e.g. "referred_by"
  label       String   // UI Label, e.g. "Referred By"
  fieldType   String   // "TEXT", "NUMBER", "DROPDOWN", "DATE", "BOOLEAN"
  options     Json?    // Array of string for DROPDOWN
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([entityType, name])
}
